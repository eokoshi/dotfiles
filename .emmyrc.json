{
  "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
  "runtime": {
    "version": "LuaJIT",
    "requirePattern": [
      "?.lua",
      "?/init.lua",
      "lua/?.lua",
      "lua/?/init.lua",
      "**/lua/?.lua",
      "**/lua/?/init.lua"
    ]
  },
  "workspace": {
    "workspaceRoots": [
      ".emmyrc.json",
      ".emmyrc.lua",
      ".luarc.json",
      ".luarc.jsonc",
      ".luacheckrc",
      ".stylua.toml",
      "stylua.toml",
      "selene.toml",
      "selene.yml",
      ".git"
    ],
    "library": ["$VIMRUNTIME", "~/.local/share/nvim/lazy"]
  },
  "diagnostics": {
    "diagnosticInterval": 500,
    "disable": ["unnecessary-if"],
    "enable": true,
    "enables": [],
    "globals": ["vim"],
    "globalsRegex": [],
    "severity": {}
  }
}
