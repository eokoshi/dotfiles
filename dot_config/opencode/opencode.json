{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "permission": {
    "*": "ask",
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git *": "ask",
      "npm *": "allow",
      "rm *": "ask",
      "grep *": "allow"
    },
    "read": "allow",
    "glob": "allow"
  }
}
