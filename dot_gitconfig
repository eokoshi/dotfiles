[credential "https://github.com"]
        helper = /usr/bin/gh auth git-credential
[init]
	defaultBranch = main

[pull]
	ff = only

[merge]
	tool = codediff
	renormalize = true

[mergetool "vimdiff"]
		layout = "LOCAL,REMOTE / MERGED) + (LOCAL,MERGED,REMOTE) + ((LOCAL/BASE/REMOTE),MERGED) + (LOCAL,BASE,REMOTE / MERGED)"

[core]
	autocrlf = input

; [url "ssh://git@github.com/"]
; 	insteadOf = https://github.com/

[mergetool "codediff"]
	cmd = "nvim \"$MERGED\" -c \"CodeDiff merge \\\"$MERGED\\\"\""

[diff]
	tool = codediff

[difftool "codediff"]
	cmd = "nvim \"$LOCAL\" \"$REMOTE\" +\"CodeDiff file $LOCAL $REMOTE\""

[rebase]
	updateRefs = true
